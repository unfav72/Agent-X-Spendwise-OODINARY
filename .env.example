# Spendwise AI Configuration Template
# Copy this file to .env and insert your API keys (optional if running in autonomous DryRun mode)

# LLM Providers (Free tiers available)
GEMINI_API_KEY=
GROQ_API_KEY=

# Provider selection: "gemini" or "groq" (auto-detected if blank)
AGENTX_PROVIDER=

# Model selection
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Agent Tuning
AGENTX_DRY_RUN=false
PORT=5000

# Custom Data Directory (defaults to ./data)
AGENTX_DATA_DIR=

